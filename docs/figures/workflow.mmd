flowchart TD
  subgraph LEGEND["Legend"]
    direction LR
    LS["Grey: system event / state"]
    LR["Orange: code"]
    LA["Purple: AI"]
    LH["Blue: human"]
    LS ~~~ LR ~~~ LA ~~~ LH
  end
  LEGEND ~~~ A
  A["System: new ticket received"] --> R["Code: rule checks<br/>non-Chinese, PII, urgency and risk<br/>link open tickets"]
  R --> M{"Code: model service healthy?"}
  M -- "Still failing after retry" --> F["Agent: manual handling<br/>rule flags kept, urgent first"]
  M -- "Healthy" --> T["AI: triage<br/>handling path, priority, risk<br/>cannot clear rule flags"]
  T -- "Spam / test data" --> SP["Code: archive, no reply"]
  T -- "High risk" --> HR["Senior agent / supervisor:<br/>handles end to end"]
  T -- "No draft / unclassifiable" --> F
  T -- "Draftable / needs details" --> G["Code: approve tools and data access<br/>verify member identity and order ownership"]
  G -- "Not verified" --> V["Agent: verify via existing process<br/>no order data until verified"]
  V --> F
  G -- "Approved" --> Q["AI: read-only lookups, compile data<br/>order system, internal knowledge<br/>open tickets when needed"]
  Q -- "Lookup failed / no basis" --> F
  Q -- "Details filled, re-triage" --> T
  Q -- "Still missing details" --> ASK["AI: draft request for details"]
  Q -- "Data complete" --> D["AI: summarize, suggest actions<br/>draft reply"]
  D --> C["Agent: review<br/>category, data, draft"]
  ASK --> C
  F --> J{"Code: refund > NT$30,000?"}
  C --> J
  J -- "Yes" --> S["Supervisor: approval"]
  J -- "No" --> O["Agent: perform required actions<br/>in the order system"]
  S --> O
  O --> SEND["Agent: send reply"]
  HR --> SEND
  SEND --> DONE["System: ticket closed"]

  classDef sys fill:#f2f2f2,stroke:#999,color:#222;
  classDef rule fill:#fff4e5,stroke:#e8a33d,color:#5a3b00;
  classDef ai fill:#f0ecff,stroke:#8b6fd6,color:#222;
  classDef human fill:#eef6ff,stroke:#5b8def,color:#123;
  class A,DONE,LS sys;
  class R,M,G,J,SP,LR rule;
  class T,Q,ASK,D,LA ai;
  class F,HR,V,C,S,O,SEND,LH human;
  style LEGEND fill:#ffffff,stroke:#b7b7b7,color:#222
